PORT=5000
NODE_ENV=development

# Database
# DB_DIALECT chagua kati ya "mysql" (Aiven) au "postgres" (Render).
#
# CHAGUO A: weka DATABASE_URL moja (mfano wa Render "External Database URL"),
# na fields za DB_HOST/DB_USER/n.k. chini hazitatumika ukiweka hii:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# CHAGUO B: gawa vipande vipande (mfano wa Aiven wako wa sasa):
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_records
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# --- Mfano wa kubadilisha kwenda Render (PostgreSQL) ---
# Toa maoni (uncomment) haya na uzime yale ya juu unapohamia Render:
# DB_DIALECT=postgres
# DB_HOST=<host-kutoka-Render-Postgres>
# DB_PORT=5432
# DB_NAME=<jina-la-database-la-Render>
# DB_USER=<username-la-Render>
# DB_PASSWORD=<password-la-Render>
# DB_SSL=true

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# School Info (used on report cards, PDFs)
SCHOOL_NAME=School Name
SCHOOL_ADDRESS=School Address

# Email (used for forgot-password reset links)
# For Gmail: enable 2-Step Verification, then create an "App Password"
# under Google Account > Security > App passwords. Use that 16-character
# code as SMTP_PASS — NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourschoolemail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=yourschoolemail@gmail.com

# Base URL of the deployed/running frontend, used to build the reset link
# sent in the email, e.g. http://localhost:5173 or https://records.school.ac.tz
FRONTEND_URL=http://localhost:5173
